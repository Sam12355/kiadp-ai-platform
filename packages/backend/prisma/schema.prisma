generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ================================================
// Enums
// ================================================

enum UserRole {
  ADMIN
  STUDENT
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  ARCHIVED
}

enum IngestionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum IngestionStep {
  EXTRACTING
  OCR
  CHUNKING
  EMBEDDING
  INDEXING
}

// ================================================
// Tenant (Institution) Model
// ================================================

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  /// 'trial' until someone pays; 'paid' is never time-limited. Institutions created by a
  /// platform admin default to 'paid' — only self-serve signups start a clock.
  plan      String   @default("paid")
  /// When the free trial lapses. Null means there is no trial to lapse.
  trialEndsAt DateTime? @map("trial_ends_at")

  /// Which band of the student ladder was bought (50…1000). Null means unmetered — the
  /// state every institution is in before a plan is assigned to it.
  studentCap Int? @map("student_cap")
  /// Questions included per calendar month. NULL MEANS NO LIMIT, deliberately: a column
  /// added to live data must not start enforcing a cap nobody agreed to.
  questionsPerMonth Int? @map("questions_per_month")
  /// Pay-as-you-go balance, drawn on only once the monthly allowance is spent.
  questionCredits Int @default(0) @map("question_credits")
  /// Whether this institution's questions may reach the expensive model. Defaults true so
  /// behaviour is unchanged until plans are actually assigned; the lower bands turn it off,
  /// which is what keeps API cost at ~5% of revenue instead of ~19%.
  allowAdvancedModel Boolean @default(true) @map("allow_advanced_model")

  usageMonths TenantUsageMonth[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  documents Document[]
  questions Question[]
  answers   Answer[]
  apiKeys   ApiKey[]

  @@map("tenants")
}

// ================================================
// Auth Models
// ================================================

/// One row per institution per calendar month.
///
/// A counter rather than a COUNT over `questions`: the quota is checked on every single
/// question, and an aggregate over a growing table is the wrong shape for that. It also
/// separates *billable* questions from rows in the questions table, so a chit-chat reply
/// or a failed answer need not be charged for.
model TenantUsageMonth {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// "YYYY-MM", so a month is a lookup rather than a range scan.
  month     String
  questions Int      @default(0)
  /// Credits consumed in this month, once the included allowance ran out. Kept separate so
  /// an invoice can show what was included and what was extra.
  creditsUsed Int    @default(0) @map("credits_used")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@index([tenantId])
  @@map("tenant_usage_month")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  passwordHash      String   @map("password_hash")
  fullName          String   @map("full_name")
  avatarUrl         String?  @map("avatar_url")
  role              UserRole @default(STUDENT)
  isActive          Boolean  @default(true) @map("is_active")
  isPendingApproval Boolean  @default(false) @map("is_pending_approval")
  tenantId          String?  @map("tenant_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]
  documents     Document[]
  questions     Question[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ================================================
// Document Models
// ================================================

model Document {
  id               String         @id @default(uuid()) @db.Uuid
  title            String
  originalFilename String         @map("original_filename")
  storedFilename   String         @map("stored_filename")
  filePath         String         @map("file_path")
  mimeType         String         @map("mime_type")
  fileSizeBytes    BigInt         @map("file_size_bytes")
  pageCount        Int?           @map("page_count")
  chunkCount       Int?           @map("chunk_count")
  status           DocumentStatus @default(UPLOADED)
  progress         Int            @default(0)
  categories       String[]       @default([])
  courseId         String?        @map("course_id")
  metadata         Json?          @default("{}")
  uploadedBy       String         @map("uploaded_by") @db.Uuid
  tenantId         String?        @map("tenant_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  uploader      User             @relation(fields: [uploadedBy], references: [id])
  tenant        Tenant?          @relation(fields: [tenantId], references: [id])
  pages         DocumentPage[]
  chunks        DocumentChunk[]
  images        DocumentImage[]
  ingestionJobs IngestionJob[]

  @@index([status])
  @@index([uploadedBy])
  @@index([tenantId])
  @@map("documents")
}

model DocumentPage {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  pageNumber Int      @map("page_number")
  rawText    String   @map("raw_text") @db.Text
  isOcr      Boolean  @default(false) @map("is_ocr")
  wordCount  Int      @map("word_count")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   DocumentChunk[]

  @@unique([documentId, pageNumber])
  @@map("document_pages")
}

/// Chunk text and metadata stored in PostgreSQL.
/// The embedding vector is stored in Pinecone (legacy) and pgvector (embedding column).
model DocumentChunk {
  id               String                 @id @default(uuid()) @db.Uuid
  documentId       String                 @map("document_id") @db.Uuid
  pageId           String?                @map("page_id") @db.Uuid
  chunkIndex       Int                    @map("chunk_index")
  content          String                 @db.Text
  tokenCount       Int                    @map("token_count")
  pageNumber       Int                    @map("page_number")
  sectionHeading   String?                @map("section_heading")
  language         String?
  pineconeVectorId String?                @map("pinecone_vector_id")
  embedding        Unsupported("vector(1536)")?
  metadata         Json?                  @default("{}")
  createdAt        DateTime               @default(now()) @map("created_at")

  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page          DocumentPage?  @relation(fields: [pageId], references: [id])
  answerSources AnswerSource[]

  @@index([documentId])
  @@index([pineconeVectorId])
  @@map("document_chunks")
}

model DocumentImage {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  pageNumber       Int      @map("page_number")
  filePath         String   @map("file_path")
  altText          String?  @map("alt_text")
  description      String?  @db.Text
  contextText      String?  @map("context_text") @db.Text
  pineconeVectorId String?  @map("pinecone_vector_id")
  width            Int?
  height           Int?
  format           String?
  createdAt        DateTime @default(now()) @map("created_at")

  document     Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  answerImages AnswerImage[]

  @@map("document_images")
}

// ================================================
// Ingestion Models
// ================================================

model IngestionJob {
  id           String          @id @default(uuid()) @db.Uuid
  documentId   String          @map("document_id") @db.Uuid
  status       IngestionStatus @default(PENDING)
  step         IngestionStep?
  progressPct  Int             @default(0) @map("progress_pct")
  errorMessage String?         @map("error_message") @db.Text
  logEntries   Json?           @default("[]") @map("log_entries")
  startedAt    DateTime?       @map("started_at")
  completedAt  DateTime?       @map("completed_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([status])
  @@map("ingestion_jobs")
}

// ================================================
// Q&A Models
// ================================================

model Question {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  queryText String   @map("query_text") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])
  answer Answer?

  @@index([userId])
  @@index([tenantId])
  @@map("questions")
}

model Answer {
  id              String   @id @default(uuid()) @db.Uuid
  questionId      String   @unique @map("question_id") @db.Uuid
  tenantId        String?  @map("tenant_id") @db.Uuid
  answerText      String   @map("answer_text") @db.Text
  confidenceScore Float?   @map("confidence_score")
  isGrounded      Boolean  @default(true) @map("is_grounded")
  groundingNote   String?  @map("grounding_note") @db.Text
  rawLlmResponse  Json?    @map("raw_llm_response")
  tokensUsed      Int?     @map("tokens_used")
  modelUsed       String?  @map("model_used")
  createdAt       DateTime @default(now()) @map("created_at")

  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tenant       Tenant?        @relation(fields: [tenantId], references: [id])
  sources      AnswerSource[]
  answerImages AnswerImage[]

  @@index([tenantId])
  @@map("answers")
}

model AnswerSource {
  id             String @id @default(uuid()) @db.Uuid
  answerId       String @map("answer_id") @db.Uuid
  chunkId        String @map("chunk_id") @db.Uuid
  documentId     String @map("document_id") @db.Uuid
  pageNumber     Int    @map("page_number")
  excerpt        String @db.Text
  relevanceScore Float  @map("relevance_score")
  rank           Int

  answer Answer        @relation(fields: [answerId], references: [id], onDelete: Cascade)
  chunk  DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("answer_sources")
}

model AnswerImage {
  id       String @id @default(uuid()) @db.Uuid
  answerId String @map("answer_id") @db.Uuid
  imageId  String @map("image_id") @db.Uuid

  answer Answer        @relation(fields: [answerId], references: [id], onDelete: Cascade)
  image  DocumentImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@map("answer_images")
}

// ================================================
// Audit
// ================================================

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ================================================
// API Usage Tracking
// ================================================

/// Aggregated daily token/request counts per AI service + model.
/// Upserted after every successful API call from our services.
model ApiUsageDay {
  id           String   @id @default(cuid())
  date         String   // "YYYY-MM-DD"
  service      String   // openai | gemini | groq | cohere
  model        String
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([date, service, model])
  @@index([service, date])
  @@map("api_usage_day")
}

// ================================================
// API Keys (machine-to-machine access)
// ================================================

/// Long-lived API keys for external integrations (Moodle, n8n, etc.).
/// The raw key is returned ONCE at creation and never stored.
/// Only the SHA-256 hash is persisted.
model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  keyHash      String    @unique @map("key_hash")
  keyPrefix    String    @map("key_prefix") // first 12 chars shown in UI, e.g. "sk-kh-a1b2c3"
  name         String    // human label, e.g. "Moodle — Royal College"
  tenantId     String?   @map("tenant_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastUsedAt   DateTime? @map("last_used_at")
  expiresAt    DateTime? @map("expires_at") // null = never expires
  requestCount Int       @default(0) @map("request_count")
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant       Tenant? @relation(fields: [tenantId], references: [id])
  createdByUser User   @relation(fields: [createdBy], references: [id])

  @@index([tenantId])
  @@map("api_keys")
}

// ================================================
// App Settings (key-value store for admin config)
// ================================================

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

# ===========================================
# Backend Environment Variables
# ===========================================

# Database
DATABASE_URL=postgresql://khalifa:khalifa_secret@localhost:5432/khalifa_knowledge

# Pinecone (Vector Storage)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=khalifa-knowledge

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# Auth
JWT_SECRET=dev-jwt-secret-change-in-production-min-16-chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# WhatsApp (Meta)
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Which institution WhatsApp questions are answered from. One WhatsApp number serves the
# whole deployment and a sender is identified only by their phone number, so nothing in an
# incoming message says which school they belong to. Leave unset and WhatsApp questions are
# refused — that is deliberate, because the alternative is answering them from every
# school's documents.
WHATSAPP_TENANT_ID=

# Production image for the Khalifa Knowledge Platform.
#
# Unlike the dev setup (docker-compose.yml), this builds ONE container: app.ts already
# serves packages/frontend/dist as static files with an SPA fallback, so the separate
# nginx container and its proxy config are unnecessary here. Caddy terminates TLS in
# front and forwards to :3001.
#
# The worker is not a separate service either — server.ts registers the pg-boss
# handlers for both queues inline at startup.

FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# ── Dependencies ──
# Dev dependencies are intentionally included: tsc, vite and the prisma CLI are all
# needed to build, and the prisma CLI is needed again at runtime by entrypoint.sh.
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/backend/package.json ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/
RUN pnpm install --frozen-lockfile

# ── Build ──
FROM deps AS build
# Baked into the client bundle at build time, so it must be present here rather than
# supplied as a runtime env var.
ARG VITE_GEMINI_API_KEY
ENV VITE_GEMINI_API_KEY=$VITE_GEMINI_API_KEY
COPY packages/shared/ ./packages/shared/
COPY packages/backend/ ./packages/backend/
COPY packages/frontend/ ./packages/frontend/
RUN pnpm --filter @khalifa/backend db:generate

# Both builds run their package's own script, so tsc is a real gate: a type error fails
# the image rather than shipping.
#
# This previously had to bypass tsc — the tree carried ~45 pre-existing type errors,
# invisible because dev runs through tsx, which strips types without checking them. The
# bulk of them came from @types/express v5 being installed against express v4 (v5 widens
# req.params values to string | string[]); that is now pinned in the root package.json
# overrides, and the genuine bugs it was masking are fixed.
RUN pnpm --filter @khalifa/backend build \
    && test -f packages/backend/dist/server.js

RUN pnpm --filter @khalifa/frontend build \
    && test -f packages/frontend/dist/index.html

# ── Runtime ──
FROM base AS production
ENV NODE_ENV=production
# tini reaps zombies and forwards SIGTERM, so the graceful shutdown in server.ts
# (boss.stop + prisma disconnect) actually runs on `docker compose down`.
RUN apk add --no-cache tini

# node_modules comes from the build stage, not deps, so the generated Prisma client
# is included. pnpm's symlinks stay valid because /app is laid out identically.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=build /app/packages/backend/node_modules ./packages/backend/node_modules
COPY --from=build /app/packages/backend/dist ./packages/backend/dist
COPY --from=build /app/packages/backend/prisma ./packages/backend/prisma
COPY --from=build /app/packages/frontend/dist ./packages/frontend/dist
COPY packages/shared/src ./packages/shared/src
COPY packages/shared/package.json ./packages/shared/
COPY packages/backend/package.json ./packages/backend/
COPY package.json pnpm-workspace.yaml ./
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /app/packages/backend
EXPOSE 3001

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["node", "dist/server.js"]
